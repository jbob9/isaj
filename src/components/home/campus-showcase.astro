---
import { Image } from "astro:assets";
import { MapPin } from "lucide-react";
import { schoolIdentity } from "../../data/site-content";

const facilities = [
  {
    title: "Espace de l'ISAJ",
    desc: "Photographie locale de l'établissement. La description précise du lieu sera confirmée par l'ISAJ.",
    image: "/isaj-1.jpeg",
    tag: "ISAJ",
  },
  {
    title: "Vie de l'établissement",
    desc: "Photographie locale de l'ISAJ. Le contexte de cette image reste à confirmer.",
    image: "/isaj-2.jpeg",
    tag: "À confirmer",
  },
  {
    title: "Activités scolaires",
    desc: "Les activités représentées et leur disponibilité seront identifiées avec l'équipe de l'école.",
    image: "/isaj-3.jpeg",
    tag: "À confirmer",
  },
];
---

<section class="overflow-hidden bg-white py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="mb-16 flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end"
    >
      <div class="max-w-2xl">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          L'ISAJ en images
        </p>
        <h2
          class="tracking-headline balance text-ink text-4xl leading-[1.05] font-semibold md:text-[3.25rem]"
        >
          Des images de <span
            class="font-display text-brand-deep font-normal italic"
            >l'établissement</span
          >
        </h2>
      </div>
      <div class="text-ink-mute flex items-center gap-2 text-[0.85rem]">
        <MapPin size={15} strokeWidth={1.6} /><span
          >{schoolIdentity.address}</span
        >
      </div>
    </div>

    <div class="grid grid-cols-12 gap-6 md:gap-8">
      {
        facilities.map((item, index) => {
          const layouts = [
            "col-span-12 md:col-span-7 md:row-span-2",
            "col-span-12 md:col-span-5",
            "col-span-12 md:col-span-5",
          ];
          const heights = [
            "h-[28rem] md:h-[36rem]",
            "h-72 md:h-[17rem]",
            "h-72 md:h-[17rem]",
          ];
          return (
            <figure
              class={`group relative overflow-hidden rounded-[1.75rem] ${layouts[index]}`}
            >
              <Image
                src={item.image}
                alt="Photographie de l'ISAJ"
                width={1200}
                height={900}
                class={`${heights[index]} w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-105`}
              />
              <div class="from-ink/85 via-ink/15 absolute inset-0 bg-gradient-to-t to-transparent" />
              <figcaption class="absolute inset-x-0 bottom-0 p-7 md:p-9">
                <span class="inline-block rounded-full bg-white/15 px-2.5 py-0.5 text-[0.7rem] font-medium tracking-[0.18em] text-white/80 uppercase backdrop-blur">
                  {item.tag}
                </span>
                <h3 class="font-display mt-3 text-[1.7rem] leading-tight font-medium text-white md:text-[2rem]">
                  {item.title}
                </h3>
                <p class="mt-2 max-w-md text-[0.9rem] leading-relaxed text-white/75">
                  {item.desc}
                </p>
              </figcaption>
            </figure>
          );
        })
      }
    </div>
  </div>
</section>
