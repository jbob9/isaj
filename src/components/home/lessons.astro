---
const lessons = [
  {
    title: "Apprentissages fondamentaux",
    level: "Programme à confirmer",
    image: "/isaj-1.jpeg",
  },
  {
    title: "Connaissances et découverte",
    level: "Programme à confirmer",
    image: "/isaj-2.jpeg",
  },
  {
    title: "Expression et créativité",
    level: "Programme à confirmer",
    image: "/isaj-3.jpeg",
  },
  {
    title: "Projets scolaires",
    level: "Informations à confirmer",
    image: "/isaj-4.jpeg",
  },
];
---

<section class="bg-white py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-16 max-w-3xl">
      <p class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase">
        Le programme
      </p>
      <h2
        class="tracking-headline balance text-ink text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.25rem]"
      >
        Découvrir les <span
          class="font-display text-brand-deep font-normal italic"
          >apprentissages</span
        > de l'ISAJ
      </h2>
    </div>

    <ul class="divide-y divide-black/[0.06] border-y border-black/[0.06]">
      {
        lessons.map((lesson, index) => (
          <li>
            <a
              href="/curriculum"
              class="group grid grid-cols-12 items-center gap-4 py-7 transition-colors hover:bg-[#fbfcfe] md:py-9"
            >
              <span class="tabular text-ink-mute col-span-2 text-[0.78rem] font-medium md:col-span-1">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="col-span-10 flex items-center gap-5 md:col-span-7">
                <div class="relative h-14 w-14 shrink-0 overflow-hidden rounded-xl md:h-16 md:w-16">
                  <img
                    src={lesson.image}
                    alt="Photographie de l'ISAJ"
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                  />
                </div>
                <h3 class="font-display text-ink group-hover:text-brand-deep text-[1.1rem] leading-tight font-medium tracking-[-0.015em] transition-colors sm:text-[1.35rem] md:text-[1.85rem]">
                  {lesson.title}
                </h3>
              </div>
              <p class="text-ink-mute col-span-12 text-[0.85rem] md:col-span-3">
                {lesson.level}
              </p>
              <div class="col-span-12 hidden justify-end md:col-span-1 md:flex">
                <span class="text-ink-mute group-hover:border-ink group-hover:bg-ink inline-flex h-9 w-9 items-center justify-center rounded-full border border-black/8 transition-all duration-300 group-hover:text-white">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  >
                    <path d="M7 17L17 7M9 7h8v8" />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
