---
import { Image } from "astro:assets";
import { ArrowUpRight } from "lucide-react";
import imgA from "../../assets/2.jpeg";
import imgB from "../../assets/5.jpeg";
import imgC from "../../assets/8.jpeg";
---

<section
  class="relative mx-auto max-w-7xl px-4 pt-10 pb-24 sm:px-6 lg:px-8 lg:pt-16 lg:pb-32"
>
  <div class="mb-10 flex justify-center">
    <span
      class="text-ink-soft inline-flex items-center gap-2 rounded-full border border-black/8 bg-white/60 px-3 py-1.5 text-[0.78rem] font-medium backdrop-blur-md"
    >
      <span class="bg-brand inline-flex h-1.5 w-1.5 rounded-full"></span>
      Institution le Saint Justien
    </span>
  </div>

  <div class="relative mx-auto max-w-5xl text-center">
    <h1
      class="tracking-headline balance text-ink text-[2.6rem] leading-[1.02] font-semibold sm:text-6xl md:text-[5.25rem] md:leading-[0.98]"
    >
      Une école pour
      <span class="font-display text-brand-deep font-normal italic"
        >grandir.</span
      >
      <br class="hidden sm:block" />
      <span class="text-ink-soft">Apprendre. Construire.</span>
    </h1>

    <p
      class="pretty text-ink-mute mx-auto mt-7 max-w-xl text-base leading-relaxed md:text-lg"
    >
      L'Institution le Saint Justien accompagne les élèves dans leur parcours
      scolaire. Les informations détaillées sur les niveaux et les activités
      sont à confirmer avec l'établissement.
    </p>

    <div
      class="mt-9 flex flex-wrap items-center justify-center gap-x-3 gap-y-2"
    >
      <a
        href="/enrollment"
        class="group bg-ink hover:bg-ink-soft inline-flex items-center gap-2 rounded-full px-6 py-3.5 text-[0.95rem] font-medium text-white transition-all active:scale-[0.98]"
      >
        Demander une inscription
        <ArrowUpRight
          size={17}
          className="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
      <a
        href="/curriculum"
        class="group text-ink decoration-ink/20 hover:decoration-ink/60 inline-flex items-center gap-2 rounded-full px-5 py-3.5 text-[0.95rem] font-medium underline decoration-1 underline-offset-[6px] transition-colors"
      >
        Découvrir le programme
      </a>
    </div>

    <p
      class="text-ink-mute mx-auto mt-10 max-w-xl text-[0.82rem] leading-relaxed"
    >
      Pour les informations officielles sur l'établissement, contactez
      directement l'ISAJ.
    </p>
  </div>

  <div class="relative mt-20 hidden md:block">
    <div class="grid grid-cols-12 items-end gap-6">
      <figure class="col-span-4">
        <Image
          src={imgA}
          alt="Photographie de l'ISAJ"
          class="shadow-ink-lg aspect-[4/5] w-full rounded-[2rem] object-cover"
        />
      </figure>
      <figure class="col-span-4 -mb-12 translate-y-6">
        <Image
          src={imgB}
          alt="Photographie de l'ISAJ"
          class="shadow-ink-lg aspect-[3/4] w-full rounded-[2rem] object-cover"
        />
      </figure>
      <figure class="col-span-4">
        <Image
          src={imgC}
          alt="Photographie de l'ISAJ"
          class="shadow-ink-lg aspect-[5/6] w-full rounded-[2rem] object-cover"
        />
      </figure>
    </div>
  </div>

  <div class="relative mt-12 md:hidden">
    <Image
      src={imgA}
      alt="Photographie de l'ISAJ"
      class="shadow-ink-lg aspect-[4/5] w-full rounded-[2rem] object-cover"
    />
  </div>
</section>
