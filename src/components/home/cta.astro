---
import { ArrowUpRight } from "lucide-react";
---

<section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
  <div
    class="grain bg-ink relative overflow-hidden rounded-[2rem] p-7 text-white sm:rounded-[2.25rem] sm:p-10 md:rounded-[2.75rem] md:p-16 lg:p-20"
  >
    <div
      class="pointer-events-none absolute -top-1/3 left-1/2 h-[60rem] w-[60rem] -translate-x-1/2 rounded-full"
      style="background: radial-gradient(circle, rgba(38,87,238,0.22) 0%, transparent 60%)"
    >
    </div>
    <div class="relative max-w-3xl">
      <p class="mb-6 text-[0.72rem] tracking-[0.22em] text-white/40 uppercase">
        Parlons de votre projet
      </p>
      <h2
        class="tracking-headline balance text-[1.75rem] leading-[1.02] font-semibold sm:text-4xl md:text-[4.5rem]"
      >
        Obtenir des informations <span
          class="font-display font-normal text-white/85 italic">fiables</span
        > sur l'ISAJ.
      </h2>
      <p
        class="pretty mt-7 max-w-xl text-[1rem] leading-relaxed text-white/55 md:text-[1.05rem]"
      >
        L'équipe de l'Institution le Saint Justien peut vous renseigner sur les
        niveaux, l'admission et les informations actuellement disponibles.
      </p>
      <div
        class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-2 sm:gap-y-3"
      >
        <a
          href="/enrollment"
          class="group text-ink inline-flex items-center justify-center gap-2 rounded-full bg-white px-7 py-4 text-[0.95rem] font-medium transition-all hover:bg-white/90 active:scale-[0.98] sm:justify-start"
          >Demander une inscription <ArrowUpRight
            size={17}
            className="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          /></a
        >
        <a
          href="/contact?purpose=partner"
          class="group inline-flex items-center justify-center gap-2 rounded-full border border-white/15 px-6 py-4 text-[0.95rem] font-medium text-white transition-colors hover:bg-white/5 sm:justify-start"
          >Devenir partenaire</a
        >
      </div>
    </div>
  </div>
</section>
