---
import { ArrowRight, ArrowUpRight } from "lucide-react";
---

<section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
  <div
    class="relative grain overflow-hidden rounded-[2.25rem] bg-ink p-10 text-white md:rounded-[2.75rem] md:p-16 lg:p-20"
  >
    {/* Ambient brand glow */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-1/3 left-1/2 h-[60rem] w-[60rem] -translate-x-1/2 rounded-full"
      style="background: radial-gradient(circle, rgba(38,87,238,0.22) 0%, transparent 60%)"
    >
    </div>

    {/* Sparse SVG accent — replaces emoji-ish bouncing elements */}
    <svg
      aria-hidden="true"
      viewBox="0 0 200 200"
      class="absolute -top-6 -right-6 h-44 w-44 text-white/[0.05]"
      fill="currentColor"
    >
      <circle cx="100" cy="100" r="98" stroke="currentColor" stroke-width="1" fill="none"></circle>
      <circle cx="100" cy="100" r="70" stroke="currentColor" stroke-width="1" fill="none" stroke-dasharray="2 4"></circle>
      <circle cx="100" cy="100" r="40" fill="currentColor"></circle>
    </svg>

    <div class="relative max-w-3xl">
      <p class="mb-6 text-[0.72rem] uppercase tracking-[0.22em] text-white/40">
        Prêt à commencer
      </p>

      <h2 class="tracking-headline balance text-4xl font-semibold leading-[1.02] md:text-[4.5rem]">
        Développez pleinement <span class="font-display italic font-normal text-white/85">le potentiel</span> de votre enfant.
      </h2>

      <p class="pretty mt-7 max-w-xl text-[1rem] leading-relaxed text-white/55 md:text-[1.05rem]">
        Rejoignez les familles qui façonnent déjà l'avenir. Nous accueillons les nouveaux élèves et les enseignants passionnés.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-2 gap-y-3">
        <a
          href="/enrollment"
          class="group inline-flex items-center gap-2 rounded-full bg-white px-7 py-4 text-[0.95rem] font-medium text-ink transition-all hover:bg-white/90 active:scale-[0.98]"
        >
          Demande d'inscription
          <ArrowUpRight size={17} className="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
        </a>
        <a
          href="/contact"
          class="group inline-flex items-center gap-2 rounded-full border border-white/15 px-6 py-4 text-[0.95rem] font-medium text-white transition-colors hover:bg-white/5"
        >
          Contacter les admissions
        </a>
      </div>

      <div class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-8 md:flex-row md:items-center">
        <p class="text-[0.85rem] text-white/45">
          Intéressé(e) à rejoindre notre équipe d'éducateurs ?
        </p>
        <a
          href="/contact"
          class="group inline-flex items-center gap-1.5 text-[0.9rem] font-medium text-white underline decoration-white/30 decoration-1 underline-offset-[6px] transition-colors hover:decoration-white"
        >
          Soumettez votre candidature
          <ArrowRight size={14} className="transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
    </div>
  </div>
</section>
