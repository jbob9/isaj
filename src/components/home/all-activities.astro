---
import { BookOpen, Music, Palette } from "lucide-react";

const activities = [
  {
    title: "Activités de classe",
    desc: "Les activités proposées en classe seront présentées avec les informations confirmées par l'établissement.",
    icon: BookOpen,
  },
  {
    title: "Projets scolaires",
    desc: "Les projets et réalisations de l'ISAJ seront ajoutés après validation de l'équipe de l'école.",
    icon: Palette,
  },
  {
    title: "Activités à confirmer",
    desc: "Contactez l'ISAJ pour connaître les activités, clubs et projets actuellement disponibles.",
    icon: Music,
  },
];
---

<section class="relative overflow-hidden py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-16 grid grid-cols-1 items-end gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Au-delà de la salle de classe
        </p>
        <h2
          class="tracking-headline balance text-ink text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.25rem]"
        >
          Les activités et projets de <span
            class="font-display text-brand-deep font-normal italic">l'ISAJ</span
          >
        </h2>
      </div>
      <p
        class="pretty text-ink-mute text-[0.95rem] leading-relaxed lg:col-span-5"
      >
        La liste des activités réellement proposées sera publiée après
        vérification auprès de l'établissement.
      </p>
    </div>

    <div
      class="grid grid-cols-1 gap-px overflow-hidden rounded-[1.75rem] bg-black/[0.06] sm:grid-cols-3"
    >
      {
        activities.map((activity, index) => (
          <article class="group relative bg-white p-7 transition-colors hover:bg-[#fbfcfe] lg:p-8">
            <div class="flex items-start justify-between">
              <activity.icon
                size={22}
                strokeWidth={1.6}
                className="text-ink transition-colors group-hover:text-brand"
              />
              <span class="tabular text-ink-mute text-[0.7rem]">
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>
            <h3 class="font-display text-ink mt-10 text-[1.35rem] leading-tight font-medium tracking-[-0.015em]">
              {activity.title}
            </h3>
            <p class="text-ink-mute mt-2 text-[0.88rem] leading-relaxed">
              {activity.desc}
            </p>
            <div class="bg-ink/15 group-hover:bg-brand mt-6 h-px w-8 transition-all duration-500 group-hover:w-16" />
          </article>
        ))
      }
    </div>

    <p class="text-ink-mute mt-12 text-[0.9rem]">
      Consultez la page <a
        href="/contact"
        class="text-ink font-medium underline underline-offset-4">Contact</a
      > pour demander la liste à jour.
    </p>
  </div>
</section>
