---
const stats = [
  { value: "1:8", label: "Ratio élève / enseignant" },
  { value: "100%", label: "Sécurité du campus" },
  { value: "15", suffix: "+", label: "Laboratoires spécialisés" },
  { value: "98%", label: "Taux de réussite" },
];
---

<section
  class="relative z-20 mx-auto -mt-2 mb-4 max-w-6xl px-4 sm:px-6 lg:px-8"
>
  <div
    class="relative grain overflow-hidden rounded-[2.25rem] bg-ink p-8 text-white shadow-ink-lg md:rounded-[2.5rem] md:p-10"
  >
    {/* hairline edge */}
    <div
      class="pointer-events-none absolute inset-0 rounded-[inherit]"
      style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), inset 0 0 0 1px rgba(255,255,255,0.04)"
    >
    </div>

    <div class="relative grid grid-cols-2 gap-y-10 lg:grid-cols-4 lg:gap-y-0">
      {
        stats.map((s, i) => (
          <div
            class={`relative px-4 ${i > 0 ? "lg:border-l lg:border-white/8" : ""}`}
          >
            <div class="tabular text-[2.25rem] font-semibold leading-none tracking-[-0.04em] text-white md:text-[2.75rem] lg:text-[3.25rem]">
              {s.value}
              {s.suffix && <span class="text-white/40">{s.suffix}</span>}
            </div>
            <p class="mt-3 max-w-[16ch] text-[0.78rem] leading-snug text-white/55">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>

    {/* Caption strip */}
    <div
      class="relative mt-10 flex flex-col items-start justify-between gap-3 border-t border-white/8 pt-6 text-[0.76rem] text-white/45 md:flex-row md:items-center"
    >
      <span class="uppercase tracking-[0.22em]">L'école en chiffres · 2025</span>
      <span class="font-display italic text-white/70">Croix des Bouquets, Haïti</span>
    </div>
  </div>
</section>
