---
const points = [
  { value: "2011", label: "Ouverture officielle" },
  { value: "03", label: "Niveaux d'enseignement" },
  { value: "ISAJ", label: "Institution Le Saint Justien" },
  { value: "Haïti", label: "Bon-Repos, Croix-des-Bouquets" },
];
---

<section
  class="relative z-20 mx-auto -mt-2 mb-4 max-w-6xl px-4 sm:px-6 lg:px-8"
>
  <div
    class="grain bg-ink shadow-ink-lg relative overflow-hidden rounded-[2.25rem] p-8 text-white md:rounded-[2.5rem] md:p-10"
  >
    <div class="relative grid grid-cols-2 gap-y-10 lg:grid-cols-4 lg:gap-y-0">
      {
        points.map((point, index) => (
          <div
            class={`relative px-4 ${index > 0 ? "lg:border-l lg:border-white/8" : ""}`}
          >
            <div class="text-[1.8rem] leading-none font-semibold tracking-[-0.04em] text-white md:text-[2.25rem]">
              {point.value}
            </div>
            <p class="mt-3 max-w-[18ch] text-[0.78rem] leading-snug text-white/55">
              {point.label}
            </p>
          </div>
        ))
      }
    </div>
    <div
      class="relative mt-10 border-t border-white/8 pt-6 text-[0.76rem] text-white/45"
    >
      Contactez l'ISAJ pour obtenir les informations officielles et à jour.
    </div>
  </div>
</section>
