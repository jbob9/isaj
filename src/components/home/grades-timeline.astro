---
import { ArrowRight, Baby, BookOpen, GraduationCap, Zap } from "lucide-react";
import { schoolLevels } from "../../data/site-content";

const icons = [Baby, BookOpen, Zap, GraduationCap];

const stages = schoolLevels.map((level, index) => ({
  ...level,
  icon: icons[index],
}));
---

<section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
  <div
    class="mb-16 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end"
  >
    <div class="max-w-2xl">
      <p class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase">
        Le parcours
      </p>
      <h2
        class="tracking-headline balance text-ink text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.25rem]"
      >
        Le parcours scolaire de l'ISAJ
      </h2>
    </div>
    <p class="pretty text-ink-mute max-w-sm text-[0.95rem] leading-relaxed">
      Découvrez les niveaux présentés par l'ISAJ. Les appellations et tranches
      d'âge sont à confirmer par l'établissement.
    </p>
  </div>

  <ol
    class="relative grid grid-cols-1 gap-px overflow-hidden rounded-[2rem] bg-black/[0.06] sm:grid-cols-2 lg:grid-cols-4"
  >
    {
      stages.map((stage, idx) => (
        <li class="bg-white">
          <a
            href={`/grade/${stage.id}`}
            class="group relative flex h-full flex-col p-8 transition-colors hover:bg-[#fdf9f2] lg:p-9"
          >
            <div class="flex items-center justify-between">
              <span class="tabular text-ink-mute text-[0.78rem] font-medium">
                {String(idx + 1).padStart(2, "0")} / 04
              </span>
              <stage.icon
                size={20}
                className="text-ink-mute transition-colors group-hover:text-brand"
                strokeWidth={1.6}
              />
            </div>

            <div class="mt-12">
              <p class="text-brand text-[0.78rem] font-medium tracking-[0.18em] uppercase">
                {stage.ageRange}
              </p>
              <h3 class="text-ink mt-2 text-[1.45rem] leading-tight font-semibold tracking-[-0.02em]">
                {stage.title}
              </h3>
              <p class="font-display text-ink-soft mt-1 text-[0.95rem] italic">
                {stage.grades}
              </p>
              <p class="text-ink-mute mt-4 text-[0.9rem] leading-relaxed">
                {stage.description}
              </p>
            </div>

            <div class="text-ink group-hover:text-brand mt-8 flex items-center gap-1.5 text-[0.82rem] font-medium transition-colors">
              Voir le niveau
              <ArrowRight
                size={14}
                className="transition-transform group-hover:translate-x-1"
              />
            </div>
          </a>
        </li>
      ))
    }
  </ol>

  <div
    class="mt-14 flex flex-col items-start justify-between gap-5 rounded-[1.75rem] border border-black/[0.06] bg-white p-8 md:flex-row md:items-center"
  >
    <div>
      <p class="font-display text-ink text-[1.3rem] italic">
        Une question sur les niveaux ?
      </p>
      <p class="text-ink-mute mt-1 text-[0.9rem]">
        Pour connaître les niveaux et conditions d'admission à jour, contactez
        directement l'ISAJ.
      </p>
    </div>
    <a
      href="/contact"
      class="group bg-ink hover:bg-ink-soft inline-flex shrink-0 items-center gap-2 rounded-full px-6 py-3 text-[0.9rem] font-medium text-white transition-all active:scale-[0.97]"
    >
      Nous contacter
      <ArrowRight
        size={15}
        className="transition-transform group-hover:translate-x-0.5"
      />
    </a>
  </div>
</section>
