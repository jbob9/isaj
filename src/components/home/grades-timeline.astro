---
import { ArrowRight, Baby, BookOpen, GraduationCap, Zap } from "lucide-react";

const stages = [
  {
    id: 1,
    title: "Petits explorateurs",
    grades: "Préscolaire",
    age: "2–5 ans",
    desc: "Cultiver la curiosité par le jeu sensoriel et les fondements du développement social.",
    icon: Baby,
  },
  {
    id: 2,
    title: "Fondamentaux",
    grades: "1ʳᵉ à 5ᵉ",
    age: "6–11 ans",
    desc: "Maîtrise de la lecture, de l'écriture, du calcul et de la résolution créative de problèmes.",
    icon: BookOpen,
  },
  {
    id: 3,
    title: "Croissance et identité",
    grades: "6ᵉ à 8ᵉ",
    age: "12–14 ans",
    desc: "Encourager la pensée critique et explorer en profondeur les intérêts personnels.",
    icon: Zap,
  },
  {
    id: 4,
    title: "Futurs leaders",
    grades: "9ᵉ à 12ᵉ",
    age: "15–18 ans",
    desc: "Préparation universitaire, parcours professionnels et compétences de leadership.",
    icon: GraduationCap,
  },
];
---

<section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
  <div class="mb-16 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
    <div class="max-w-2xl">
      <p class="mb-4 text-[0.72rem] uppercase tracking-[0.22em] text-ink-mute">
        Le parcours
      </p>
      <h2 class="tracking-headline balance text-[1.75rem] font-semibold leading-[1.05] text-ink sm:text-4xl md:text-[3.25rem]">
        Un voyage complet, <span class="font-display italic font-normal text-brand-deep">de A à Z</span>
      </h2>
    </div>
    <p class="pretty max-w-sm text-[0.95rem] leading-relaxed text-ink-mute">
      Nous accompagnons votre enfant à chaque étape importante de sa scolarité — une transition fluide, des premiers pas au diplôme.
    </p>
  </div>

  <ol class="relative grid grid-cols-1 gap-px overflow-hidden rounded-[2rem] bg-black/[0.06] sm:grid-cols-2 lg:grid-cols-4">
    {
      stages.map((stage, idx) => (
        <li class="bg-white">
          <a
            href={`/grade/${stage.id}`}
            class="group relative flex h-full flex-col p-8 transition-colors hover:bg-[#fbfcfe] lg:p-9"
          >
            <div class="flex items-center justify-between">
              <span class="tabular text-[0.78rem] font-medium text-ink-mute">
                {String(idx + 1).padStart(2, "0")} / 04
              </span>
              <stage.icon size={20} className="text-ink-mute transition-colors group-hover:text-brand" strokeWidth={1.6} />
            </div>

            <div class="mt-12">
              <p class="text-[0.78rem] font-medium uppercase tracking-[0.18em] text-brand">
                {stage.age}
              </p>
              <h3 class="mt-2 text-[1.45rem] font-semibold leading-tight tracking-[-0.02em] text-ink">
                {stage.title}
              </h3>
              <p class="mt-1 font-display text-[0.95rem] italic text-ink-soft">
                {stage.grades}
              </p>
              <p class="mt-4 text-[0.9rem] leading-relaxed text-ink-mute">
                {stage.desc}
              </p>
            </div>

            <div class="mt-8 flex items-center gap-1.5 text-[0.82rem] font-medium text-ink transition-colors group-hover:text-brand">
              Voir le niveau
              <ArrowRight size={14} className="transition-transform group-hover:translate-x-1" />
            </div>
          </a>
        </li>
      ))
    }
  </ol>

  {/* Footnote CTA — quieter, more refined */}
  <div class="mt-14 flex flex-col items-start justify-between gap-5 rounded-[1.75rem] border border-black/[0.06] bg-white p-8 md:flex-row md:items-center">
    <div>
      <p class="font-display text-[1.3rem] italic text-ink">Prêt à commencer le voyage ?</p>
      <p class="mt-1 text-[0.9rem] text-ink-mute">
        Consultez le guide complet des programmes scolaires 2026.
      </p>
    </div>
    <a
      href="/curriculum"
      class="group inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-[0.9rem] font-medium text-white transition-all hover:bg-ink-soft active:scale-[0.97]"
    >
      Consulter le prospectus
      <ArrowRight size={15} className="transition-transform group-hover:translate-x-0.5" />
    </a>
  </div>
</section>
