---

<section class="relative overflow-hidden py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="rounded-[1.75rem] border border-black/[0.06] bg-white p-8 sm:p-10 md:p-14"
    >
      <p class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase">
        Paroles des familles
      </p>
      <h2
        class="tracking-headline text-ink max-w-3xl text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.25rem]"
      >
        Les témoignages authentiques seront publiés <span
          class="font-display text-brand-deep font-normal italic"
          >après validation.</span
        >
      </h2>
      <p class="text-ink-mute mt-6 max-w-2xl text-[0.95rem] leading-relaxed">
        Nous ne publions pas de nom, de citation ou de portrait sans
        confirmation et autorisation de la famille concernée.
      </p>
      <a
        href="/contact"
        class="group text-ink decoration-ink/20 hover:decoration-ink mt-8 inline-flex items-center gap-2 text-[0.9rem] font-medium underline decoration-1 underline-offset-[6px] transition-colors"
        >Nous contacter <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
</section>
