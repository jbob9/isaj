---
import { ArrowUpRight } from "lucide-react";

const cards = [
  {
    title: "Compétences de vie",
    subtitle: "Confiance · Autonomie · Collaboration",
    image: "/cround.jpeg",
    number: "01",
  },
  {
    title: "L'imagination, un pouvoir",
    subtitle: "Créativité · Curiosité · Expression",
    image: "/isaj-4.jpeg",
    number: "02",
  },
  {
    title: "Déployer ses propres ailes",
    subtitle: "Excellence · Persévérance · Caractère",
    image: "/isaj-3.jpeg",
    number: "03",
  },
];
---

<section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
  <div
    class="mb-14 flex flex-col items-start justify-between gap-8 md:flex-row md:items-end"
  >
    <div class="max-w-2xl">
      <p class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase">
        Notre promesse
      </p>
      <h2
        class="tracking-headline balance text-ink text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.25rem]"
      >
        Des enfants brillants, prêts à prendre <span
          class="font-display text-brand-deep font-normal italic"
          >leur envol.</span
        >
      </h2>
    </div>
    <div class="flex items-center gap-8">
      <p class="text-ink-mute max-w-xs text-[0.9rem] leading-relaxed">
        Une approche cohérente où chaque enfant développe sa propre voix — une
        leçon à la fois.
      </p>
      <a
        href="/enrollment"
        class="group text-ink hover:bg-ink hidden shrink-0 items-center gap-2 rounded-full border border-black/[0.08] px-5 py-3 text-[0.85rem] font-medium transition-colors hover:text-white sm:inline-flex"
      >
        Inscrivez-vous
        <ArrowUpRight
          size={15}
          className="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
    {
      cards.map((card) => (
        <a
          href="/curriculum"
          class="group bg-ink shadow-ink relative flex h-80 flex-col overflow-hidden rounded-[1.75rem] text-white sm:h-112"
        >
          {/* Image — top portion */}
          <div class="absolute inset-0 overflow-hidden">
            <img
              src={card.image}
              alt="Photographie locale de l'ISAJ"
              class="h-full w-full object-cover opacity-70 transition-all duration-[1200ms] ease-out group-hover:scale-105 group-hover:opacity-80"
            />
            <div class="from-ink via-ink/70 to-ink/10 absolute inset-0 bg-gradient-to-t" />
          </div>

          <div class="relative z-10 flex h-full flex-col justify-between p-7">
            <div class="flex items-start justify-between">
              <span class="tabular text-[0.78rem] font-medium tracking-wider text-white/55">
                {card.number}
              </span>
              <span class="group-hover:text-ink rounded-full bg-white/10 p-2 backdrop-blur-md transition-all duration-300 group-hover:bg-white">
                <ArrowUpRight size={16} />
              </span>
            </div>

            <div>
              <h3 class="font-display text-[1.5rem] leading-[1.05] font-medium tracking-[-0.015em] text-white sm:text-[2rem]">
                {card.title}
              </h3>
              <p class="mt-3 text-[0.78rem] tracking-[0.16em] text-white/55 uppercase">
                {card.subtitle}
              </p>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</section>
