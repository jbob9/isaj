---
import { ArrowUpRight, MapPin, Mail, Phone } from "lucide-react";
import { contactDetails } from "../data/site-content";
---

<footer
  class="bg-ink relative mt-12 overflow-hidden rounded-t-[2.5rem] text-white"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 h-[40rem] w-[40rem] -translate-x-1/2 rounded-full"
    style="background: radial-gradient(circle, rgba(38,87,238,0.18) 0%, transparent 60%)"
  >
  </div>
  <div class="relative mx-auto max-w-7xl px-6 pt-20 pb-10 lg:px-8 lg:pt-24">
    <div
      class="mb-16 grid grid-cols-1 items-end gap-10 lg:grid-cols-12 lg:gap-16"
    >
      <div class="lg:col-span-7">
        <p class="text-[0.72rem] tracking-[0.22em] text-white/40 uppercase">
          Institution le Saint Justien
        </p>
        <h2
          class="font-display tracking-headline mt-3 text-5xl leading-[0.95] font-medium text-white md:text-7xl lg:text-[5.5rem]"
        >
          L'ISAJ, <span class="text-white/65 italic">à découvrir.</span>
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="max-w-md text-[0.95rem] leading-relaxed text-white/55">
          Retrouvez les informations disponibles sur l'Institution le Saint
          Justien et contactez directement l'établissement pour les détails à
          confirmer.
        </p>
        <a
          href="/enrollment"
          class="group text-ink mt-6 inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-[0.88rem] font-medium transition-all hover:bg-white/90"
          >Demander une inscription <ArrowUpRight size={15} /></a
        >
      </div>
    </div>

    <div
      class="grid grid-cols-2 gap-10 border-t border-white/10 pt-12 sm:grid-cols-4"
    >
      <div>
        <p
          class="mb-4 text-[0.72rem] tracking-[0.18em] text-white/40 uppercase"
        >
          Explorer
        </p><ul class="space-y-2.5 text-[0.92rem]">
          <li>
            <a href="/" class="text-white/75 transition-colors hover:text-white"
              >Accueil</a
            >
          </li><li>
            <a
              href="/curriculum"
              class="text-white/75 transition-colors hover:text-white"
              >Programme</a
            >
          </li><li>
            <a
              href="/gallery"
              class="text-white/75 transition-colors hover:text-white"
              >Galerie</a
            >
          </li><li>
            <a
              href="/teams"
              class="text-white/75 transition-colors hover:text-white"
              >Notre équipe</a
            >
          </li>
        </ul>
      </div>
      <div>
        <p
          class="mb-4 text-[0.72rem] tracking-[0.18em] text-white/40 uppercase"
        >
          Admissions
        </p><ul class="space-y-2.5 text-[0.92rem]">
          <li>
            <a
              href="/enrollment"
              class="text-white/75 transition-colors hover:text-white"
              >Inscription</a
            >
          </li><li>
            <a
              href="/curriculum"
              class="text-white/75 transition-colors hover:text-white"
              >Programme scolaire</a
            >
          </li><li>
            <a
              href="/contact"
              class="text-white/75 transition-colors hover:text-white"
              >Poser une question</a
            >
          </li>
        </ul>
      </div>
      <div>
        <p
          class="mb-4 text-[0.72rem] tracking-[0.18em] text-white/40 uppercase"
        >
          Contact
        </p><ul class="space-y-2.5 text-[0.92rem]">
          <li class="flex items-start gap-2 text-white/75">
            <MapPin
              size={14}
              className="mt-1 shrink-0 text-white/40"
              strokeWidth={1.6}
            /><span
              >5, Impasse Bernard, Bon-Repos<br />Croix-des-Bouquets, Haïti</span
            >
          </li><li class="flex items-start gap-2 text-white/75">
            <Mail
              size={14}
              className="mt-1 shrink-0 text-white/40"
              strokeWidth={1.6}
            /><a
              href={`mailto:${contactDetails.email}`}
              class="break-all transition-colors hover:text-white"
              >{contactDetails.email}</a
            >
          </li><li class="flex items-start gap-2 text-white/75">
            <Phone
              size={14}
              className="mt-1 shrink-0 text-white/40"
              strokeWidth={1.6}
            /><span
              >{
                contactDetails.phones.map((phone) => (
                  <a
                    href={phone.href}
                    class="block transition-colors hover:text-white"
                  >
                    {phone.display}
                  </a>
                ))
              }</span
            >
          </li>
        </ul>
      </div>
      <div>
        <p
          class="mb-4 text-[0.72rem] tracking-[0.18em] text-white/40 uppercase"
        >
          À confirmer
        </p><p class="text-[0.92rem] leading-relaxed text-white/55">
          Les informations institutionnelles, les activités et les réseaux
          sociaux seront complétés après validation.
        </p><a
          href="/contact"
          class="mt-4 inline-flex items-center gap-2 text-[0.88rem] font-medium text-white/80 underline underline-offset-4 transition-colors hover:text-white"
          >Nous écrire <ArrowUpRight size={14} /></a
        >
      </div>
    </div>

    <div
      class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-6 text-[0.78rem] text-white/40 md:flex-row md:items-center"
    >
      <span>Les contenus à confirmer sont signalés sur le site.</span><span
        >© 2026 ISAJ. Tous droits réservés.</span
      >
    </div>
  </div>
</footer>
