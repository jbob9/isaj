---
import { ArrowUpRight, MapPin, Mail, Phone } from "lucide-react";
---

<footer class="relative mt-12 overflow-hidden rounded-t-[2.5rem] bg-ink text-white">
  {/* Ambient brand glow */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 h-[40rem] w-[40rem] -translate-x-1/2 rounded-full"
    style="background: radial-gradient(circle, rgba(38,87,238,0.18) 0%, transparent 60%)"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-6 pt-20 pb-10 lg:px-8 lg:pt-24">
    {/* Large display wordmark */}
    <div class="mb-16 grid grid-cols-1 items-end gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="text-[0.72rem] uppercase tracking-[0.22em] text-white/40">
          Institution le Saint Justien
        </p>
        <h2 class="font-display tracking-headline mt-3 text-5xl font-medium leading-[0.95] text-white md:text-7xl lg:text-[5.5rem]">
          Façonnons l'avenir, <span class="italic text-white/65">ensemble.</span>
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="max-w-md text-[0.95rem] leading-relaxed text-white/55">
          Une éducation cohérente, exigeante et chaleureuse, à chaque étape du parcours. De la maternelle au lycée.
        </p>
        <a
          href="/enrollment"
          class="group mt-6 inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-[0.88rem] font-medium text-ink transition-all hover:bg-white/90"
        >
          Inscrivez votre enfant
          <ArrowUpRight size={15} className="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
        </a>
      </div>
    </div>

    {/* Link grid */}
    <div class="grid grid-cols-2 gap-10 border-t border-white/10 pt-12 sm:grid-cols-4">
      <div>
        <p class="mb-4 text-[0.72rem] uppercase tracking-[0.18em] text-white/40">Explorer</p>
        <ul class="space-y-2.5 text-[0.92rem]">
          <li><a href="/" class="text-white/75 transition-colors hover:text-white">Accueil</a></li>
          <li><a href="/curriculum" class="text-white/75 transition-colors hover:text-white">Programme</a></li>
          <li><a href="/gallery" class="text-white/75 transition-colors hover:text-white">Galerie</a></li>
          <li><a href="/teams" class="text-white/75 transition-colors hover:text-white">Notre équipe</a></li>
        </ul>
      </div>
      <div>
        <p class="mb-4 text-[0.72rem] uppercase tracking-[0.18em] text-white/40">Admissions</p>
        <ul class="space-y-2.5 text-[0.92rem]">
          <li><a href="/enrollment" class="text-white/75 transition-colors hover:text-white">Inscription</a></li>
          <li><a href="/curriculum" class="text-white/75 transition-colors hover:text-white">Prospectus 2026</a></li>
          <li><a href="/contact" class="text-white/75 transition-colors hover:text-white">Carrières</a></li>
          <li><a href="/contact" class="text-white/75 transition-colors hover:text-white">Visites guidées</a></li>
        </ul>
      </div>
      <div>
        <p class="mb-4 text-[0.72rem] uppercase tracking-[0.18em] text-white/40">Contact</p>
        <ul class="space-y-2.5 text-[0.92rem]">
          <li class="flex items-start gap-2 text-white/75">
            <MapPin size={14} className="mt-1 shrink-0 text-white/40" strokeWidth={1.6} />
            <span>5, Impasse Bernard, Bon-Repos<br />Croix-des-Bouquets, Haïti</span>
          </li>
          <li class="flex items-center gap-2 text-white/75">
            <Mail size={14} className="text-white/40" strokeWidth={1.6} />
            <a href="mailto:contact@isaj.edu.ht" class="transition-colors hover:text-white">contact@isaj.edu.ht</a>
          </li>
          <li class="flex items-start gap-2 text-white/75">
            <Phone size={14} className="mt-1 shrink-0 text-white/40" strokeWidth={1.6} />
            <span>
              <a href="tel:+50942518828" class="transition-colors hover:text-white">(509) 4251-8828</a><br />
              <a href="tel:+17744989660" class="transition-colors hover:text-white">+1 (774) 498-9660</a>
            </span>
          </li>
        </ul>
      </div>
      <div>
        <p class="mb-4 text-[0.72rem] uppercase tracking-[0.18em] text-white/40">Suivez-nous</p>
        <div class="flex gap-2">
          <a href="#" aria-label="Instagram" class="group rounded-full border border-white/10 p-3 text-white/70 transition-all hover:border-white hover:text-white">
            <svg role="img" class="size-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"></path>
            </svg>
          </a>
          <a href="#" aria-label="Facebook" class="group rounded-full border border-white/10 p-3 text-white/70 transition-all hover:border-white hover:text-white">
            <svg class="size-4 fill-current" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"></path>
            </svg>
          </a>
        </div>
        <p class="mt-4 text-[0.78rem] leading-relaxed text-white/45">
          Suivez la vie quotidienne du campus.
        </p>
      </div>
    </div>

    {/* Bottom bar */}
    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-6 text-[0.78rem] text-white/40 md:flex-row md:items-center">
      <div class="flex flex-wrap gap-6">
        <a href="#" class="transition-colors hover:text-white">Politique de confidentialité</a>
        <a href="#" class="transition-colors hover:text-white">Conditions d'utilisation</a>
      </div>
      <div>
        © 2026 ISAJ. Tous droits réservés.
      </div>
    </div>
  </div>
</footer>
