---
import "../styles/global.css";
import Footer from "./Footer.astro";
import Navbar from "./navbar";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ISAJ — Institution le Saint Justien",
  description = "Institution le Saint Justien (ISAJ), à Bon-Repos, Croix-des-Bouquets, Haïti.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#edf2ff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-[var(--color-ink)] focus:px-4 focus:py-2 focus:text-sm focus:text-white"
      >Aller au contenu</a
    >
    <div
      class="relative min-h-screen overflow-hidden bg-[var(--color-paper)] text-[var(--color-ink)] selection:bg-[var(--color-brand)] selection:text-white"
    >
      <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
        <div
          class="absolute top-[-10%] left-[-5%] h-[60vh] w-[60vh] rounded-full bg-[#b8cfff] opacity-55 blur-[120px]"
        >
        </div>
        <div
          class="absolute right-[-10%] bottom-[-10%] h-[55vh] w-[55vh] rounded-full bg-[#7ba8ff] opacity-35 blur-[120px]"
        >
        </div>
      </div>

      <Navbar client:load />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <style is:global>
      html,
      body {
        margin: 0;
        width: 100%;
      }
      body {
        min-height: 100dvh;
      }
    </style>
  </body>
</html>
