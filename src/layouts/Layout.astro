---
import "../styles/global.css";
import Footer from "./Footer.astro";
import Navbar from "./navbar";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f6fb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Institution le Saint Justien (ISAJ) — Une éducation cohérente et de calibre mondial, de la maternelle au lycée, à Croix des Bouquets."
    />
    <title>ISAJ — Institution le Saint Justien</title>
  </head>
  <body class="antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-[var(--color-ink)] focus:px-4 focus:py-2 focus:text-sm focus:text-white"
      >Aller au contenu</a
    >
    <div
      class="relative min-h-screen overflow-hidden bg-[var(--color-paper)] text-[var(--color-ink)] selection:bg-[var(--color-brand)] selection:text-white"
    >
      {/* Ambient backdrop — single warm glow + a cool one, very subtle */}
      <div
        aria-hidden="true"
        class="pointer-events-none fixed inset-0 -z-10"
      >
        <div
          class="absolute top-[-10%] left-[-5%] h-[60vh] w-[60vh] rounded-full bg-[#dfe8ff] opacity-60 blur-[120px]"
        >
        </div>
        <div
          class="absolute right-[-10%] bottom-[-10%] h-[55vh] w-[55vh] rounded-full bg-[#fff1e0] opacity-50 blur-[120px]"
        >
        </div>
      </div>

      <Navbar client:load />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <style is:global>
      html,
      body {
        margin: 0;
        width: 100%;
      }
      body {
        min-height: 100dvh;
      }
    </style>
  </body>
</html>
