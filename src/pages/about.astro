---
import {
  ArrowLeft,
  ArrowUpRight,
  BookOpen,
  HeartHandshake,
  Landmark,
  Lightbulb,
  Users,
} from "lucide-react";
import Layout from "../layouts/Layout.astro";
import {
  institutionalFacts,
  institutionalDrafts,
  perspectives,
  schoolIdentity,
  values,
} from "../data/site-content";
---

<Layout
  title={`À propos — ${schoolIdentity.name}`}
  description={`${schoolIdentity.name} accompagne les enfants et les jeunes du préscolaire au secondaire à Bon-Repos, Croix-des-Bouquets.`}
>
  <section
    class="mx-auto max-w-7xl px-4 pt-12 pb-20 sm:px-6 lg:px-8 lg:pt-16 lg:pb-24"
  >
    <a
      href="/"
      class="group text-ink-mute hover:text-ink inline-flex items-center gap-2 text-[0.85rem] transition-colors"
    >
      <ArrowLeft
        size={15}
        className="transition-transform group-hover:-translate-x-0.5"
      />
      Retour à l'accueil
    </a>
    <div
      class="mt-10 grid grid-cols-1 items-end gap-10 lg:grid-cols-12 lg:gap-16"
    >
      <div class="lg:col-span-8">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Qui sommes-nous ?
        </p>
        <h1
          class="tracking-headline balance text-ink text-[2rem] leading-[1.02] font-semibold sm:text-5xl md:text-[5.5rem]"
        >
          Éduquer aujourd'hui,
          <span class="font-display text-brand-deep font-normal italic"
            >préparer l'avenir.</span
          >
        </h1>
      </div>
      <p
        class="pretty text-ink-mute max-w-md text-[1rem] leading-relaxed lg:col-span-4"
      >
        {institutionalFacts.whoWeAre}
      </p>
    </div>
    <div
      class="mt-16 grid grid-cols-1 gap-px overflow-hidden rounded-[2rem] bg-black/[0.06] sm:grid-cols-3"
    >
      <div class="bg-white p-7 lg:p-9">
        <Landmark size={22} className="text-brand" /><p
          class="text-ink-mute mt-8 text-[0.72rem] tracking-[0.18em] uppercase"
        >
          Ouverture officielle
        </p><p class="font-display text-ink mt-2 text-2xl">
          {schoolIdentity.openingDate}
        </p>
      </div>
      <div class="bg-white p-7 lg:p-9">
        <BookOpen size={22} className="text-brand" /><p
          class="text-ink-mute mt-8 text-[0.72rem] tracking-[0.18em] uppercase"
        >
          Parcours
        </p><p class="font-display text-ink mt-2 text-2xl">
          Du préscolaire au secondaire
        </p>
      </div>
      <div class="bg-white p-7 lg:p-9">
        <Users size={22} className="text-brand" /><p
          class="text-ink-mute mt-8 text-[0.72rem] tracking-[0.18em] uppercase"
        >
          Implantation
        </p><p class="font-display text-ink mt-2 text-2xl">
          {schoolIdentity.location}
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-4">
          <p class="text-ink-mute text-[0.72rem] tracking-[0.22em] uppercase">
            Notre histoire
          </p><h2
            class="tracking-headline text-ink mt-5 text-[1.8rem] leading-[1.05] font-semibold sm:text-4xl"
          >
            Une initiative née d'un besoin de la communauté.
          </h2>
        </div>
        <div class="space-y-6 lg:col-span-8">
          {
            institutionalFacts.history.map((paragraph) => (
              <p class="text-ink-mute max-w-3xl text-[1.05rem] leading-[1.8]">
                {paragraph}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div
      class="grid grid-cols-1 gap-px overflow-hidden rounded-[2rem] bg-black/[0.06] md:grid-cols-2"
    >
      <article class="bg-ink p-9 text-white md:p-12">
        <p class="text-[0.72rem] tracking-[0.22em] text-white/45 uppercase">
          Notre mission
        </p><p
          class="font-display mt-8 text-[1.65rem] leading-[1.35] text-white/90 italic"
        >
          {institutionalFacts.mission}
        </p>
      </article>
      <article class="bg-white p-9 md:p-12">
        <p class="text-ink-mute text-[0.72rem] tracking-[0.22em] uppercase">
          Notre vision
        </p><p
          class="font-display text-ink mt-8 text-[1.65rem] leading-[1.35] italic"
        >
          {institutionalFacts.vision}
        </p>
      </article>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
      <div class="mb-14 max-w-2xl">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Nos valeurs
        </p><h2
          class="tracking-headline text-ink text-[1.8rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.25rem]"
        >
          Des repères pour <span
            class="font-display text-brand-deep font-normal italic"
            >grandir ensemble.</span
          >
        </h2>
      </div>
      <ul
        class="grid grid-cols-2 gap-px overflow-hidden rounded-[1.5rem] bg-black/[0.06] sm:grid-cols-3 lg:grid-cols-5"
      >
        {
          values.map((value, index) => (
            <li class="bg-[var(--color-paper)] p-6 lg:p-7">
              <>
                <span class="tabular text-ink-mute text-[0.72rem]">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <p class="font-display text-ink mt-10 text-[1.1rem] leading-tight">
                  {value}
                </p>
              </>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Notre approche
        </p><h2
          class="tracking-headline text-ink text-[1.8rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3rem]"
        >
          Apprendre, se construire, <span
            class="font-display text-brand-deep font-normal italic"
            >contribuer.</span
          >
        </h2>
      </div>
      <div class="lg:col-span-7">
        <p class="text-ink-mute max-w-2xl text-[1.15rem] leading-[1.7]">
          {institutionalFacts.approach}
        </p><div
          class="mt-12 flex items-start gap-4 border-t border-black/[0.07] pt-8"
        >
          <HeartHandshake size={22} className="text-brand mt-1 shrink-0" /><p
            class="text-ink-mute max-w-xl text-[0.98rem] leading-relaxed"
          >
            {institutionalFacts.community}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p
            class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
          >
            Nos perspectives
          </p><h2
            class="tracking-headline text-ink text-[1.8rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3rem]"
          >
            Des axes de développement pour <span
              class="font-display text-brand-deep font-normal italic"
              >l'avenir.</span
            >
          </h2><p
            class="text-ink-mute mt-6 max-w-md text-[0.95rem] leading-relaxed"
          >
            Ces perspectives décrivent des axes de renforcement et non des
            services déjà disponibles.
          </p>
        </div><ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:col-span-7">
          {
            perspectives.map((item, index) => (
              <li class="flex items-start gap-3 rounded-2xl border border-black/[0.06] p-5">
                <>
                  <span class="tabular text-brand-deep text-[0.72rem]">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="text-ink text-[0.92rem] leading-relaxed">
                    {item}
                  </span>
                </>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div
      class="grid grid-cols-1 gap-8 rounded-[2rem] border border-black/[0.06] bg-white p-9 md:grid-cols-2 md:p-14"
    >
      <div>
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Mot de la direction
        </p><h2
          class="tracking-headline text-ink text-3xl leading-[1.08] font-semibold md:text-[3rem]"
        >
          L'éducation au cœur de notre <span
            class="font-display text-brand-deep font-normal italic"
            >action.</span
          >
        </h2>
      </div><blockquote
        class="font-display text-ink text-[1.25rem] leading-[1.55] italic"
      >
        «&nbsp;{institutionalFacts.directorMessage}&nbsp;»<footer
          class="text-ink-mute mt-6 font-sans text-[0.78rem] not-italic"
        >
          Osnel Saint-Juste · Directeur fondateur
        </footer>
      </blockquote>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-32">
    <div
      class="grain bg-ink relative overflow-hidden rounded-[2.25rem] p-10 text-white md:p-16"
    >
      <Lightbulb className="text-white/75" size={24} /><p
        class="mt-6 text-[0.72rem] tracking-[0.22em] text-white/45 uppercase"
      >
        Partenariats
      </p><h2
        class="tracking-headline mt-4 max-w-3xl text-[1.8rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.5rem]"
      >
        Construire davantage d'opportunités <span
          class="font-display font-normal text-white/75 italic">ensemble.</span
        >
      </h2><p class="mt-6 max-w-2xl text-[1rem] leading-relaxed text-white/60">
        {institutionalFacts.partnerMessage}
      </p><a
        href="/contact?purpose=partner"
        class="group text-ink mt-9 inline-flex items-center gap-2 rounded-full bg-white px-7 py-4 text-[0.95rem] font-medium transition-all hover:bg-white/90 active:scale-[0.98]"
        >Devenir partenaire <ArrowUpRight
          size={16}
          className="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        /></a
      >
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-32">
    <div class="mb-10">
      <p class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase">
        Informations à compléter
      </p><h2
        class="tracking-headline text-ink text-3xl leading-[1.05] font-semibold md:text-[2.75rem]"
      >
        Les éléments nécessitant une validation officielle.
      </h2>
    </div><div
      class="grid grid-cols-1 gap-px overflow-hidden rounded-[1.5rem] bg-black/[0.06] md:grid-cols-2 lg:grid-cols-3"
    >
      {
        institutionalDrafts.map((item) => (
          <article class="bg-white p-7">
            <>
              <p class="text-brand-deep text-[0.7rem] tracking-[0.18em] uppercase">
                À confirmer
              </p>
              <h3 class="font-display text-ink mt-5 text-[1.25rem] font-medium">
                {item.title}
              </h3>
              <p class="text-ink-mute mt-3 text-[0.88rem] leading-relaxed">
                {item.text}
              </p>
            </>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
