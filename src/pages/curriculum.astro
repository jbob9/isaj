---
import {
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  Brain,
  Compass,
  Microscope,
  Rocket,
} from "lucide-react";
import Layout from "../layouts/Layout.astro";

const curriculumLevels = [
  {
    title: "Académie des Petits Isajiens",
    kicker: "La fondation de la curiosité",
    grades: "2 à 6 ans · Préscolaire (API)",
    icon: Compass,
    details: [
      {
        label: "Étapes cognitives",
        items: [
          "La permanence de l'objet par le jeu",
          "Reconnaissance des formes et des couleurs",
          "Exposition auditive bilingue",
        ],
      },
      {
        label: "Développement social",
        items: [
          "Ateliers de régulation émotionnelle",
          "Fondements du jeu coopératif",
          "Histoires qui développent l'empathie",
        ],
      },
      {
        label: "Croissance physique",
        items: [
          "Activités de motricité fine",
          "Exploration de la nature en plein air",
          "Mouvement rythmique et danse",
        ],
      },
    ],
  },
  {
    title: "Fondamentale · 1ᵉʳ & 2ᵉ Cycles",
    kicker: "Maîtrise des fondamentaux",
    grades: "Dès 5 ans ½ · 1ʳᵉ à 6ᵉ année (API)",
    icon: Microscope,
    details: [
      {
        label: "Corps académique",
        items: [
          "Méthodologie mathématique",
          "Programmes d'alphabétisation immersive",
          "Perspectives historiques du monde",
        ],
      },
      {
        label: "Intégration STIM",
        items: [
          "Introduction à la logique et au codage",
          "Science du jardinage durable",
          "Projets de conception",
        ],
      },
      {
        label: "Expression créative",
        items: [
          "Ateliers d'arts visuels",
          "Théorie et pratique musicales",
          "Confiance à l'oral et prise de parole",
        ],
      },
    ],
  },
  {
    title: "École Mixte le Saint Justien",
    kicker: "Naviguer vers l'indépendance",
    grades: "Dès 10 ans · 3ᵉ Cycle Fondamental",
    icon: Brain,
    details: [
      {
        label: "Noyau avancé",
        items: [
          "Lectures et critiques littéraires",
          "Pré-algèbre et géométrie",
          "Études géopolitiques mondiales",
        ],
      },
      {
        label: "Laboratoire d'innovation",
        items: [
          "Principes du développement d'applications",
          "Robotique et ingénierie",
          "Défense de l'environnement",
        ],
      },
      {
        label: "Découverte de soi",
        items: [
          "Leadership et éthique",
          "Rotation des intérêts professionnels",
          "Coaching en santé et bien-être",
        ],
      },
    ],
  },
  {
    title: "Institution le Saint Justien",
    kicker: "Préparation à l'impact",
    grades: "Après le Fondamental · Secondaire (ISAJ)",
    icon: Rocket,
    details: [
      {
        label: "Excellence académique",
        items: [
          "Parcours de niveau avancé (AP)",
          "Éducation économique et financière",
          "Psychologie et sciences du comportement",
        ],
      },
      {
        label: "Préparation au monde réel",
        items: [
          "Stages en entreprise",
          "Programme passerelle universitaire",
          "Entrepreneuriat social",
        ],
      },
      {
        label: "Citoyen du monde",
        items: [
          "Maîtrise multilingue",
          "Échanges internationaux",
          "Projets à impact communautaire",
        ],
      },
    ],
  },
];

const overviewFigures = [
  { value: "4", label: "Cycles complets" },
  { value: "5", suffix: "+", label: "Langues enseignées" },
  { value: "12", label: "Ateliers spécialisés" },
  { value: "1:8", label: "Ratio en maternelle" },
];
---

<Layout>
  <section
    class="mx-auto max-w-7xl px-4 pt-12 pb-20 sm:px-6 lg:px-8 lg:pt-16 lg:pb-24"
  >
    {/* Breadcrumb */}
    <a
      href="/"
      class="group inline-flex items-center gap-2 text-[0.85rem] text-ink-mute transition-colors hover:text-ink"
    >
      <ArrowLeft
        size={15}
        className="transition-transform group-hover:-translate-x-0.5"
      />
      Retour à l'accueil
    </a>

    {/* Header */}
    <div class="mt-10 grid grid-cols-1 items-end gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-8">
        <p
          class="mb-4 text-[0.72rem] uppercase tracking-[0.22em] text-ink-mute"
        >
          Prospectus · Année scolaire 2026
        </p>
        <h1
          class="tracking-headline balance text-[2rem] leading-[1.02] font-semibold text-ink sm:text-5xl md:text-[5.5rem]"
        >
          Le programme,
          <span class="font-display italic font-normal text-brand-deep"
            >chapitre par chapitre.</span
          >
        </h1>
      </div>
      <p
        class="pretty max-w-md text-[1rem] leading-relaxed text-ink-mute lg:col-span-4"
      >
        Un regard transparent et détaillé sur la manière dont nous cultivons le
        potentiel à chaque étape du développement éducatif d'un enfant.
      </p>
    </div>

    {/* Overview strip */}
    <div
      class="mt-16 grid grid-cols-2 gap-y-8 border-y border-black/[0.07] py-8 lg:grid-cols-4"
    >
      {
        overviewFigures.map((f, i) => (
          <div
            class={`px-4 ${i > 0 ? "lg:border-l lg:border-black/[0.07]" : ""}`}
          >
            <div class="tabular text-[2rem] font-semibold leading-none tracking-[-0.025em] text-ink md:text-[2.5rem]">
              {f.value}
              {f.suffix && <span class="text-ink-mute/50">{f.suffix}</span>}
            </div>
            <p class="mt-2.5 text-[0.78rem] leading-snug text-ink-mute">
              {f.label}
            </p>
          </div>
        ))
      }
    </div>

    {/* Table of contents */}
    <div class="mt-16 grid grid-cols-1 gap-12 lg:grid-cols-12">
      <p
        class="text-[0.72rem] uppercase tracking-[0.22em] text-ink-mute lg:col-span-3"
      >
        Sommaire
      </p>
      <ol class="space-y-1 lg:col-span-9">
        {
          curriculumLevels.map((level, idx) => (
            <li>
              <a
                href={`#chapitre-${idx + 1}`}
                class="group flex items-baseline justify-between gap-4 border-b border-black/[0.06] py-3.5 transition-colors hover:text-brand-deep"
              >
                <span class="flex items-baseline gap-5">
                  <span class="tabular text-[0.78rem] font-medium text-ink-mute">
                    {String(idx + 1).padStart(2, "0")}
                  </span>
                  <span class="font-display text-[1.15rem] leading-tight text-ink transition-colors group-hover:text-brand-deep">
                    {level.title}
                  </span>
                </span>
                <span
                  class="hidden flex-1 self-end border-b border-dotted border-black/15 mx-3 mb-2 md:block"
                />
                <span class="text-[0.8rem] text-ink-mute whitespace-nowrap">
                  {level.grades}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ============== Chapters ============== */}
  {
    curriculumLevels.map((level, idx) => (
      <section
        id={`chapitre-${idx + 1}`}
        class={`scroll-mt-24 ${idx % 2 === 1 ? "bg-white" : ""}`}
      >
        <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
          <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
            {/* Sidebar */}
            <div class="lg:col-span-4">
              <div class="lg:sticky lg:top-28">
                <div class="flex items-center justify-between">
                  <p class="tabular text-[0.78rem] font-medium tracking-[0.18em] text-ink-mute uppercase">
                    Chapitre {String(idx + 1).padStart(2, "0")} / 04
                  </p>
                  <level.icon
                    size={20}
                    strokeWidth={1.6}
                    className="text-ink-mute"
                  />
                </div>

                <h2 class="tracking-headline mt-10 text-[1.75rem] font-semibold leading-[1.05] text-ink sm:text-4xl md:text-[3rem]">
                  {level.title}
                </h2>

                <p class="font-display mt-4 text-[1.25rem] leading-snug italic text-ink-soft">
                  {level.kicker}.
                </p>

                <p class="mt-6 text-[0.85rem] text-brand-deep">
                  {level.grades}
                </p>

                <a
                  href={`/grade/${idx + 1}`}
                  class="group mt-10 inline-flex items-center gap-1.5 text-[0.9rem] font-medium text-ink underline decoration-ink/15 decoration-1 underline-offset-[6px] transition-colors hover:text-brand-deep hover:decoration-brand-deep"
                >
                  Demander le programme complet
                  <ArrowUpRight
                    size={14}
                    className="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                  />
                </a>
              </div>
            </div>

            {/* Detail columns */}
            <div class="lg:col-span-8">
              <div class="grid grid-cols-1 gap-px overflow-hidden rounded-[1.5rem] bg-black/[0.06] md:grid-cols-3">
                {level.details.map((detail, dIdx) => (
                  <div class="flex flex-col bg-[var(--color-paper)] p-7 lg:p-8">
                    <span class="tabular text-[0.72rem] tracking-[0.18em] text-ink-mute uppercase">
                      {String(dIdx + 1).padStart(2, "0")}
                    </span>
                    <h3 class="font-display mt-8 text-[1.1rem] font-medium leading-tight text-ink">
                      {detail.label}
                    </h3>
                    <ul class="mt-5 space-y-3">
                      {detail.items.map((item) => (
                        <li class="flex items-start gap-2.5 text-[0.88rem] leading-snug text-ink-soft">
                          <span class="mt-1.5 inline-block h-1 w-1 shrink-0 rounded-full bg-ink/30" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  {/* ============== Bottom CTA ============== */}
  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-32">
    <div
      class="grain relative overflow-hidden rounded-[2.25rem] bg-ink p-10 text-white md:rounded-[2.5rem] md:p-16"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-32 right-0 h-[40rem] w-[40rem] rounded-full"
        style="background: radial-gradient(circle, rgba(38,87,238,0.22) 0%, transparent 60%)"
      >
      </div>

      <div class="relative grid grid-cols-1 items-end gap-10 md:grid-cols-12">
        <div class="md:col-span-7">
          <p class="text-[0.72rem] uppercase tracking-[0.22em] text-white/45">
            Visite portes ouvertes
          </p>
          <h2
            class="tracking-headline balance mt-4 text-[1.75rem] font-semibold leading-[1.05] sm:text-4xl md:text-[3.5rem]"
          >
            Prêts à façonner <span
              class="font-display italic font-normal text-white/75"
              >leur avenir</span
            >&nbsp;?
          </h2>
          <p class="mt-6 max-w-lg text-[0.95rem] leading-relaxed text-white/55">
            Participez à notre prochaine visite pour échanger avec nos chefs de
            service, voir les classes en mouvement et poser toutes vos
            questions.
          </p>
        </div>
        <div class="flex flex-col gap-3 md:col-span-5 md:items-end">
          <a
            href="/contact"
            class="group inline-flex items-center gap-2 rounded-full bg-white px-7 py-4 text-[0.95rem] font-medium text-ink transition-all hover:bg-white/90 active:scale-[0.98]"
          >
            Réserver une visite
            <ArrowUpRight
              size={16}
              className="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
            />
          </a>
          <a
            href="/enrollment"
            class="group inline-flex items-center gap-1.5 text-[0.88rem] font-medium text-white/85 underline decoration-white/25 decoration-1 underline-offset-[6px] transition-colors hover:text-white hover:decoration-white"
          >
            Démarrer l'inscription
            <ArrowRight
              size={13}
              className="transition-transform group-hover:translate-x-0.5"
            />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
