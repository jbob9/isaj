---
import { ArrowRight, ArrowUpRight } from "lucide-react";
import Layout from "../layouts/Layout.astro";
import { institutionalDrafts } from "../data/site-content";

const principles = [
  {
    no: "01",
    title: "L'élève d'abord",
    body: "Les informations publiées doivent rester centrées sur le parcours et l'accompagnement des élèves.",
  },
  {
    no: "02",
    title: "Une information exacte",
    body: "Les noms, fonctions, qualifications et responsabilités seront publiés après validation par l'établissement.",
  },
  {
    no: "03",
    title: "Une équipe à découvrir",
    body: "Contactez l'ISAJ pour connaître l'équipe actuellement en fonction et les possibilités de collaboration.",
  },
];
---

<Layout>
  <section class="mx-auto max-w-7xl px-4 pt-16 pb-12 sm:px-6 lg:px-8 lg:pt-24">
    <div class="grid grid-cols-1 items-end gap-12 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Notre équipe
        </p>
        <h1
          class="tracking-headline balance text-ink text-[2rem] leading-[1.02] font-semibold sm:text-5xl md:text-[5.5rem]"
        >
          Les personnes qui font vivre <span
            class="font-display text-brand-deep font-normal italic"
            >l'ISAJ.</span
          >
        </h1>
      </div>
      <p
        class="pretty text-ink-mute max-w-md text-[1rem] leading-relaxed lg:col-span-4"
      >
        La composition de l'équipe, les fonctions et les biographies seront
        publiées uniquement après confirmation par l'Institution le Saint
        Justien.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div
      class="rounded-[2.25rem] border border-black/[0.06] bg-white p-8 md:p-14"
    >
      <p class="text-brand-deep text-[0.72rem] tracking-[0.22em] uppercase">
        Équipe et direction
      </p>
      <h2
        class="tracking-headline text-ink mt-5 max-w-3xl text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.25rem]"
      >
        Les noms, rôles et parcours sont <span
          class="font-display text-brand-deep font-normal italic"
          >à confirmer.</span
        >
      </h2>
      <p class="text-ink-mute mt-6 max-w-2xl text-[0.98rem] leading-relaxed">
        Cette page ne présente pas de personnel fictif. L'ISAJ pourra fournir
        une liste officielle des membres de son équipe, avec leur fonction et
        leur autorisation de publication.
      </p>
      <a
        href="/contact"
        class="group bg-ink hover:bg-ink-soft mt-8 inline-flex items-center gap-2 rounded-full px-6 py-3.5 text-[0.9rem] font-medium text-white transition-all active:scale-[0.98]"
        >Demander les informations à jour <ArrowUpRight
          size={15}
          className="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        /></a
      >
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div class="mb-14 max-w-2xl">
      <p class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase">
        Notre engagement
      </p>
      <h2
        class="tracking-headline balance text-ink text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.25rem]"
      >
        Une présentation <span
          class="font-display text-brand-deep font-normal italic"
          >responsable.</span
        >
      </h2>
    </div>
    <ol
      class="grid grid-cols-1 gap-px overflow-hidden rounded-[2rem] bg-black/[0.06] md:grid-cols-3"
    >
      {
        principles.map((principle) => (
          <li class="flex flex-col bg-white p-9 lg:p-10">
            <span class="tabular text-ink-mute text-[0.78rem] font-medium">
              {principle.no} / 03
            </span>
            <h3 class="font-display text-ink mt-12 text-[1.5rem] leading-tight font-medium tracking-[-0.015em]">
              {principle.title}
            </h3>
            <p class="text-ink-mute mt-3 text-[0.92rem] leading-relaxed">
              {principle.body}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="mb-12 max-w-2xl">
      <p class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase">
        Informations en préparation
      </p>
      <h2
        class="tracking-headline text-ink text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3rem]"
      >
        Les informations institutionnelles seront <span
          class="font-display text-brand-deep font-normal italic"
          >complétées.</span
        >
      </h2>
    </div>
    <div
      class="grid grid-cols-1 gap-px overflow-hidden rounded-[1.5rem] bg-black/[0.06] md:grid-cols-2"
    >
      {
        institutionalDrafts
          .filter((item) => item.title === "Direction fondatrice")
          .map((item) => (
            <article class="bg-white p-7 lg:p-9">
              <p class="text-brand-deep text-[0.7rem] tracking-[0.18em] uppercase">
                À confirmer
              </p>
              <h3 class="font-display text-ink mt-5 text-[1.35rem] font-medium">
                {item.title}
              </h3>
              <p class="text-ink-mute mt-3 text-[0.92rem] leading-relaxed">
                {item.text}
              </p>
            </article>
          ))
      }
      <article class="bg-white p-7 lg:p-9">
        <p class="text-brand-deep text-[0.7rem] tracking-[0.18em] uppercase">
          À confirmer
        </p>
        <h3 class="font-display text-ink mt-5 text-[1.35rem] font-medium">
          Personnel de l'établissement
        </h3>
        <p class="text-ink-mute mt-3 text-[0.92rem] leading-relaxed">
          Les membres de l'équipe et leurs fonctions seront ajoutés après
          validation et accord de publication.
        </p>
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-32">
    <div
      class="grid grid-cols-1 items-center gap-8 rounded-[2rem] border border-black/[0.06] bg-white p-9 md:grid-cols-2 md:p-12"
    >
      <div>
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Contact
        </p>
        <h2
          class="tracking-headline text-ink text-3xl leading-[1.1] font-semibold md:text-[2.5rem]"
        >
          Vous souhaitez parler à <span
            class="font-display text-brand-deep font-normal italic"
            >l'équipe</span
          > ?
        </h2>
        <p class="text-ink-mute mt-4 max-w-md text-[0.95rem] leading-relaxed">
          Écrivez à l'ISAJ pour obtenir les informations actuelles sur la
          direction, les enseignants et les possibilités de collaboration.
        </p>
      </div>
      <div class="flex flex-col gap-3 md:items-end">
        <a
          href="/contact"
          class="group bg-ink hover:bg-ink-soft inline-flex items-center gap-2 rounded-full px-6 py-3.5 text-[0.95rem] font-medium text-white transition-all active:scale-[0.98]"
          >Nous contacter <ArrowUpRight
            size={16}
            className="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          /></a
        >
        <a
          href="/curriculum"
          class="group text-ink-mute decoration-ink/15 hover:text-ink hover:decoration-ink inline-flex items-center gap-1.5 text-[0.85rem] font-medium underline decoration-1 underline-offset-[6px] transition-colors"
          >Voir le programme <ArrowRight
            size={13}
            className="transition-transform group-hover:translate-x-0.5"
          /></a
        >
      </div>
    </div>
  </section>
</Layout>
