---
import {
  BrainCircuit,
  GraduationCap,
  Heart,
  Palette,
  Quote,
  Star,
} from "lucide-react";
import Layout from "../layouts/Layout.astro";
import director1 from "../assets/director-1.jpeg";
import teams from "../assets/teams.jpeg";
import director from "../assets/3.jpeg";
import { Image } from 'astro:assets';

const staff = [
  {
    name: "James Wilson",
    role: "Art & Creativity",
    image: director,
    color: "bg-green-100",
    icon: Palette,
  },
  {
    name: "Elena Rodriguez",
    role: "STEM Specialist",
    image: teams,
    color: "bg-blue-100",
    icon: BrainCircuit,
  },
 
];
---

<Layout>
  <section
    id="team"
    class="animate-in fade-in slide-in-from-bottom-4 mx-auto max-w-7xl overflow-hidden px-4 py-24 duration-700 sm:px-6 lg:px-8"
  >
    {/* Section Header */}
    <div class="mb-20 text-center">
      <span
        class="mb-4 block text-xs font-bold tracking-widest text-blue-500 uppercase"
        >Notre personnel dévoué</span
      >
      <h2 class="mb-4 text-4xl font-bold text-[#3D2C26] md:text-5xl">
        The <span class="font-serif text-blue-500 italic">Cœur</span> de  L'Institution le Saint Justien (ISAJ)
      </h2>
      <p class="mx-auto max-w-2xl text-gray-500">
        Rencontrez les éducateurs et les mentors passionnés qui se consacrent à façonner l'avenir de votre enfant avec amour et créativité.
      </p>
    </div>

    {/* Director Spotlight */}
    <div
      class="mb-32 grid grid-cols-1 items-center gap-16 rounded-[3rem] border border-gray-50 bg-white p-8 shadow-xl shadow-gray-100 md:p-16 lg:grid-cols-2"
    >
      <div class="relative">
        <div
          class="blob-shape-1 aspect-square w-full overflow-hidden border-8 border-white bg-blue-100 shadow-2xl md:aspect-4/5"
        >
          <Image
            src={director1}
            width={500}
            height={500}
            alt="School Director"
            class="h-full w-full object-cover"
          />
        </div>
        {/* Decorative element */}
        <div
          class="absolute -right-6 -bottom-6 animate-pulse rounded-full bg-yellow-400 p-6 shadow-lg"
        >
          <GraduationCap className="text-white" size={32} />
        </div>
      </div>

      <div class="relative">
        <Quote className="absolute -top-10 -left-6 text-blue-200" size={80} />
        <h3
          class="mb-4 text-sm font-bold tracking-widest text-blue-500 uppercase"
        >
          Directeur fondateur
        </h3>
        <h4 class="mb-6 text-3xl font-bold text-[#3D2C26] md:text-4xl">
          Osnel Saint Juste
        </h4>
        <p class="mb-8 font-serif text-lg leading-relaxed text-gray-600 italic">
          "L'éducation est le levier le plus puissant pour transformer une vie, une famille, une communauté. C'est cette conviction qui nous a poussés, malgré les obstacles, à ouvrir les portes de l'ISAJ en 2011 — pour que chaque enfant de la plaine du Cul-de-Sac ait sa chance."
        </p>
        <div class="flex items-center gap-4 border-t border-gray-100 pt-8">
          <p class="text-xs font-medium text-gray-500">
            Fondateur de l'ISAJ · Depuis 2011 · <span class="text-blue-600">Diplômé de l'École Normale Supérieure (ENS)</span>
          </p>
        </div>
      </div>
    </div>

    {/* Staff Grid */}
    <div class="mb-12 text-center">
      <h3 class="text-2xl font-bold text-[#3D2C26]">Rencontrez nos Mentors</h3>
    </div>

    <div class="flex items-center justify-center gap-20">
      {
        staff.map((member, idx) => (
          <div class="group text-center">
            <div
              class={`relative mx-auto mb-6 size-64 transform transition-all duration-500 group-hover:-translate-y-2`}
            >
              <div
                class={`absolute inset-0 ${member.color} blob-shape-2 rotate-12 opacity-60 transition-transform duration-700 group-hover:rotate-45`}
              />
              <div class="relative z-10 size-64 overflow-hidden rounded-full border-4 border-white shadow-lg">
                <Image
                  src={member.image}
                  alt={member.name}
                  class="h-full w-full object-cover transition-all duration-500 group-hover:grayscale-0"
                />
              </div>
              <div class="absolute -right-2 -bottom-2 z-20 transform rounded-xl bg-white p-3 shadow-lg transition-transform group-hover:scale-110">
                <member.icon className="text-blue-500" size={18} />
              </div>
            </div>
            <h5 class="mb-1 text-xl font-bold text-[#3D2C26]">{member.name}</h5>
            <p class="text-sm font-medium text-gray-500">{member.role}</p>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
